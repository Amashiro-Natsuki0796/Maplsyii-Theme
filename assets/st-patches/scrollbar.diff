+/*
+ * Scrollbar on the right edge.
+ *
+ * st has no scrollbar of its own; the scrollback buffer was invisible, so
+ * there was no way to tell how far back a window was scrolled or how much
+ * history was left. The bar is drawn by xdrawscrollbar() after the text and
+ * it tracks term.scr, which the wheel and Shift+PageUp/PageDown move.
+ *
+ *   scrollbar         0 = off, 1 = on
+ *   scrollbar_width   pixels, at the right edge of the window
+ *   scrollbar_fg      palette index the thumb colour is taken from
+ *   scrollbar_alpha   thumb opacity, 0..1. The window is already translucent
+ *                     (ST_ALPHA), so a fully opaque thumb would read as a
+ *                     black stripe pasted over the wallpaper. Keeping it well
+ *                     under 1.0 blends it onto the glass the same way the text
+ *                     sits on it. 0.30 is visible on any wallpaper without
+ *                     covering what is behind it.
+ */
+static int scrollbar = 1;
+static int scrollbar_width = 10;
+static unsigned int scrollbar_fg = 8;    /* thumb: bright black */
+static double scrollbar_alpha = 0.42;
