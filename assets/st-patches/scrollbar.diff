+/* Draw the scrollback scrollbar on the right edge.
+ *
+ * Called from draw() after the text, so it sits on top of any cell that
+ * reaches the edge. Only drawn when there is history to show: a terminal that
+ * has never scrolled does not need a thumb that is the whole track.
+ *
+ * Two things make it feel like part of the terminal rather than a black stripe
+ * pasted on:
+ *
+ *   - nothing opaque is ever painted. Xft only offers rectangles, and a solid
+ *     rectangle in the background colour reads as a black bar even though the
+ *     rest of the window is 60% transparent. Both the track and the thumb are
+ *     alpha-blended onto whatever is already in the back buffer, so the
+ *     wallpaper keeps showing through exactly as it does behind the text.
+ *   - the caps are round. st has no drawing primitives beyond rectangles, so
+ *     each cap is a stack of one-pixel rows whose inset follows a circle.
+ *
+ * The track is deliberately *not* filled: the scrollbar sits over the text
+ * margin, so a track tint would just darken the right edge for no reason. The
+ * thumb alone carries the affordance, which is also how the scrollbars in
+ * most editors behave when idle. */
+static void
+xdrawscrollbar(void)
+{
+	double frac, size, track, thumb, top;
+	int x0, w0;
+	XRenderColor rc;
+	static XftColor thumbcol;   /* kept: allocated once, reused every frame */
+	static int alloced;
+
+	if (!scrollbar || scrollbar_width <= 0)
+		return;
+	if (!tscrollfrac(&frac, &size))
+		return;
+	/* Nothing scrolled past yet: no bar at all. */
+	if (size >= 0.999)
+		return;
+
+	w0 = scrollbar_width;
+	x0 = win.w - w0;
+	if (x0 < borderpx)
+		return;
+
+	track = win.h;
+	thumb = size * track;
+	if (thumb < 12)
+		thumb = 12;              /* stay grabbable */
+	if (thumb > track)
+		thumb = track;
+
+	/* frac == 0 is the live bottom, so the thumb hangs off the end. */
+	top = (1.0 - frac) * track - thumb;
+	if (top < 0)
+		top = 0;
+	if (top + thumb > track)
+		top = track - thumb;
+
+	/* The thumb colour, with an alpha that leaves the wallpaper visible.
+	 *
+	 * Allocated once and reused: XftColorAllocValue is a round trip to the
+	 * server and this runs on every frame. The pixels come from the palette so
+	 * the bar matches the theme, but the alpha is ours - palette entries are
+	 * fully opaque, and an opaque thumb is exactly the black stripe to avoid.
+	 */
+	if (!alloced) {
+		XColor pc;
+
+		/* Resolve the configured palette entry to actual RGB, then re-add it
+		 * with our own alpha. */
+		if (!XParseColor(xw.dpy, xw.cmap,
+		                 colorname[scrollbar_fg] ? colorname[scrollbar_fg]
+		                                         : "#7a8478", &pc))
+			pc.red = pc.green = pc.blue = 0x8888;
+		/* A 32-bit X pixmap is *premultiplied* ARGB, so a translucent colour
+		 * has to have its channels scaled by alpha before it is drawn.
+		 * XRenderFillRectangle (what XftDrawRect uses) writes the colour
+		 * straight into the destination rather than compositing it, so an
+		 * un-premultiplied colour shows up as a solid, fully opaque bar - and
+		 * one that is far too bright, because its channels were never scaled.
+		 * That is why the thumb first rendered as flat #7a8478. */
+		rc.alpha = (unsigned short)(65535.0 * scrollbar_alpha);
+		rc.red = (unsigned short)(pc.red * scrollbar_alpha);
+		rc.green = (unsigned short)(pc.green * scrollbar_alpha);
+		rc.blue = (unsigned short)(pc.blue * scrollbar_alpha);
+		if (!XftColorAllocValue(xw.dpy, xw.vis, xw.cmap, &rc, &thumbcol)) {
+			/* Fall back to the palette entry as-is; a visible bar is better
+			 * than none. */
+			thumbcol = dc.col[scrollbar_fg];
+		}
+		alloced = 1;
+	}
+
+	/* Thumb: a rounded bar, both ends capped. */
+	{
+		int tx = x0 + 1;             /* inset from the window edge */
+		int tw = w0 - 2;             /* visible thumb width */
+		int ty = (int)top + 1;
+		int th = (int)thumb - 2;
+		int r = tw / 2;              /* a true pill cap */
+
+		if (th < 2)
+			th = 2;
+		if (r > th / 2)
+			r = th / 2;              /* short thumb: caps meet in the middle */
+
+		if (r <= 0) {
+			XftDrawRect(xw.draw, &thumbcol, tx, ty, tw, th);
+		} else {
+			int i;
+
+			/* Straight sides between the two caps. */
+			XftDrawRect(xw.draw, &thumbcol, tx,
+			            ty + r, tw, th - 2 * r);
+
+			for (i = 0; i < r; i++) {
+				/* dy from the cap's centre, in pixels; the 0.5 puts the
+				 * curve on pixel centres rather than edges. */
+				double dy = (double)(r - i) - 0.5;
+				double inset = r - sqrt(r * r - dy * dy);
+				int dx = (int)(inset + 0.5);
+
+				if (tw - 2 * dx <= 0)
+					continue;
+				XftDrawRect(xw.draw, &thumbcol, tx + dx,
+				            ty + i, tw - 2 * dx, 1);
+				XftDrawRect(xw.draw, &thumbcol, tx + dx,
+				            ty + th - 1 - i, tw - 2 * dx, 1);
+			}
+		}
+	}
+}
+
+/* Scroll so the thumb lands under the pointer.
+ *
+ * The track maps linearly onto the whole buffer: the top of the window is the
+ * oldest line, the bottom is the live output. So the row under the pointer,
+ * as a fraction of the window height, is directly the fraction of history to
+ * scroll to - no need to model the thumb's own size here, which keeps a drag
+ * from feeling "sticky" when the thumb is long.
+ *
+ * Used for the press as well as the motion, so clicking the track jumps and
+ * dragging follows continuously. */
+static void
+scrollbar_track(int y)
+{
+	int depth = tscroll_depth();
+	double pos;
+
+	if (win.h <= 0)
+		return;
+
+	/* y == win.h is the live bottom (fully scrolled down). */
+	pos = 1.0 - (double)y / (double)win.h;
+	if (pos < 0.0) pos = 0.0;
+	if (pos > 1.0) pos = 1.0;
+
+	tscrollto((int)(pos * depth + 0.5));
+}
+
+/* Is (px, py) inside the scrollbar strip? Window coordinates. */
+static int
+scrollbarhit(int px, int py)
+{
+	(void)py;
+	if (!scrollbar || scrollbar_width <= 0)
+		return 0;
+	if (win.w - px > scrollbar_width)
+		return 0;
+	/* Only when there is something to scroll. */
+	{
+		double frac, size;
+
+		if (!tscrollfrac(&frac, &size))
+			return 0;
+		if (size >= 0.999)
+			return 0;
+	}
+	return 1;
+}
