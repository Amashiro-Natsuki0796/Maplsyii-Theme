+/* ---- scrollbar geometry -----------------------------------------------
+ *
+ * The thumb is proportional: it occupies (rows / (rows + history)) of the
+ * track, so a long buffer gives a short thumb and the size tells you how much
+ * output has scrolled past. Its position is term.scr / (rows + history), where
+ * term.scr == 0 is the live bottom.
+ *
+ * "history" is limited to what has actually been filled. histi counts the
+ * lines that have been pushed into the ring, and until it wraps that is the
+ * only history that exists - using HISTSIZE from the start would make the
+ * thumb tiny at startup and grow as the buffer filled, which looks like the
+ * bar is settling rather than like data.
+ */
+static int
+histdepth(void)
+{
+	return term.histlen;
+}
+
+int
+trows(void)
+{
+	return term.row;
+}
+
+int
+tscroll_depth(void)
+{
+	return histdepth();
+}
+
+int
+tscrollfrac(double *frac, double *size)
+{
+	int depth = histdepth();
+	int total = term.row + depth;
+
+	if (total <= 0)
+		return 0;
+
+	/* Clamp: term.scr can exceed the real depth for a moment after a resize
+	 * shrinks the window. */
+	if (term.scr > depth)
+		term.scr = depth;
+
+	*frac = (double)term.scr / (double)total;
+	*size = (double)term.row / (double)total;
+	return 1;
+}
+
+/* Jump so the top of the visible area is at history line `target`
+ * (0 = live bottom, depth = oldest line). */
+void
+tscrollto(int target)
+{
+	int depth = histdepth();
+	int want;
+	Arg a;
+
+	if (target < 0)
+		target = 0;
+	if (target > depth)
+		target = depth;
+
+	want = target - term.scr;
+	if (want == 0)
+		return;
+
+	a.i = want;
+	if (want > 0)
+		kscrollup(&a);
+	else {
+		a.i = -want;
+		kscrolldown(&a);
+	}
+}
